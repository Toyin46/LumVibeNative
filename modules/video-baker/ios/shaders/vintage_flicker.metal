// Hand-translated from engine-ts/effects/vintage_flicker.ts's GLSL, as a
// proven-correct reference to check transpile-shaders.sh's automated
// output against — not generated by SPIRV-Cross (that tool wasn't
// available to run in this pass). This is real, carefully-written MSL,
// but like every other iOS file, it has not met a Metal compiler yet.
#include <metal_stdlib>
using namespace metal;

struct VertexOut {
    float4 position [[position]];
    float2 texCoord;
};

// Matches GLES2RenderBackend.mm's quad vertex buffer layout: 2 floats
// position + 2 floats texcoord, interleaved, 4 vertices.
struct VertexIn {
    float2 position [[attribute(0)]];
    float2 texCoord [[attribute(1)]];
};

vertex VertexOut vertexMain(uint vertexId [[vertex_id]],
                             constant float4* vertices [[buffer(0)]]) {
    VertexOut out;
    float4 v = vertices[vertexId]; // xy = position, zw = texCoord — matches the interleaved quad buffer
    out.position = float4(v.xy, 0.0, 1.0);
    out.texCoord = v.zw;
    return out;
}

// Mirrors vintage_flicker.ts's `constants` (uIntensity) and `bindings`
// (uTime) — MetalRenderBackend's uniform buffer packs these by the offset
// table transpile-shaders.sh's sidecar metadata provides. Field order
// here must match that offset table; shown as a plain struct for clarity.
struct Uniforms {
    float uTime;
    float uIntensity;
};

float hash(float2 p) {
    return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

fragment float4 fragmentMain(VertexOut in [[stage_in]],
                              texture2d<float> uTexture [[texture(0)]],
                              constant Uniforms& u [[buffer(0)]]) {
    constexpr sampler s(mag_filter::linear, min_filter::linear);
    float4 color = uTexture.sample(s, in.texCoord);

    float frameSeed = floor(u.uTime * 24.0);
    float flicker = 0.94 + 0.06 * hash(float2(frameSeed, 0.0));
    color.rgb *= mix(1.0, flicker, u.uIntensity);

    float grain = (hash(in.texCoord * 500.0 + frameSeed) - 0.5) * 0.08 * u.uIntensity;
    color.rgb += grain;

    float2 leakCenter = float2(0.15 + 0.1 * sin(u.uTime * 0.1), 0.15 + 0.1 * cos(u.uTime * 0.07));
    float leakDist = distance(in.texCoord, leakCenter);
    float leak = smoothstep(0.6, 0.0, leakDist) * 0.35 * u.uIntensity;
    color.rgb += float3(1.0, 0.55, 0.2) * leak;

    float vig = smoothstep(0.9, 0.3, distance(in.texCoord, float2(0.5)));
    color.rgb *= mix(1.0, vig, 0.4 * u.uIntensity);

    return color;
}
