# .env.example — safe to commit. Copy to .env and fill in real values.
# .env itself must NEVER be committed (see .gitignore).

SENTRY_DSN=

MUX_TOKEN_ID=
MUX_SECRET_KEY=
MUX_ENVIRONMENT_ID=
MUX_ENVIRONMENT_KEY=

LIVEKIT_URL=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_FREESOUND_API_KEY=

# OAuth client IDs are public and safe as EXPO_PUBLIC_ vars.
# Client SECRETS must never appear here or anywhere in the app —
# they live only in Supabase Edge Function secrets (see
# supabase-edge-functions/oauth-token-exchange).
EXPO_PUBLIC_YOUTUBE_CLIENT_ID=
EXPO_PUBLIC_INSTAGRAM_CLIENT_ID=
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=
